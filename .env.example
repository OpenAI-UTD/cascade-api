# Cascade local development placeholders.
# Copy to .env for local-only overrides. Do not commit real secrets.

CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=cascade
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cascade_incident_memory
QDRANT_KNOWLEDGE_COLLECTION=cascade_knowledge_base
QDRANT_API_KEY=

KAFKA_BOOTSTRAP_SERVERS=redpanda.cascade-system.svc.cluster.local:9092

EMBEDDING_DIMENSIONS=128
WEB_CONCURRENCY=1

RETRIEVAL_SERVICE_URL=http://retrieval-service.cascade-system.svc.cluster.local:8012
KNOWLEDGE_RETRIEVAL_SERVICE_URL=http://knowledge-retrieval-service.cascade-system.svc.cluster.local:8016
TOPOLOGY_SERVICE_URL=http://topology-service.cascade-system.svc.cluster.local:8004
CAUSAL_RECONSTRUCTION_SERVICE_URL=http://causal-reconstruction-service.cascade-system.svc.cluster.local:8005
INCIDENT_TIMELINE_SERVICE_URL=http://incident-timeline-service.cascade-system.svc.cluster.local:8006
ANOMALY_DETECTOR_SERVICE_URL=http://anomaly-detector-service.cascade-system.svc.cluster.local:8014
AGENT_TOOL_GATEWAY_URL=http://agent-tool-gateway.cascade-system.svc.cluster.local:8017
AGENT_RUNTIME_MODE=deterministic
LLM_PROVIDER=none
LLM_MODEL=
AGENT_EVENTS_TOPIC=agent.investigations
AGENT_PUBLISH_EVENTS=true

CHAOS_PLANNER_SERVICE_URL=http://chaos-planner-service.cascade-system.svc.cluster.local:8019
CHAOS_EXECUTOR_SERVICE_URL=http://chaos-executor-service.cascade-system.svc.cluster.local:8020
CHAOS_EVENTS_TOPIC=chaos.experiments
CHAOS_PUBLISH_EVENTS=true
CHAOS_ALLOWED_NAMESPACE=cascade-targets
CHAOS_DEFAULT_TARGET_SERVICE=catalogue

REMEDIATION_RECOMMENDER_SERVICE_URL=http://remediation-recommender-service.cascade-system.svc.cluster.local:8021
APPROVAL_SERVICE_URL=http://approval-service.cascade-system.svc.cluster.local:8022
REMEDIATION_EXECUTOR_SERVICE_URL=http://remediation-executor-service.cascade-system.svc.cluster.local:8023
REMEDIATION_EVENTS_TOPIC=remediation.actions
REMEDIATION_PUBLISH_EVENTS=true
EXECUTION_ENABLED=false
ENABLE_DANGEROUS_ACTIONS=false
ENABLE_REAL_CHAOS=false
ENABLE_REAL_REMEDIATION=false
CASCADE_LIVE_DEMO_MODE=false
CASCADE_ALLOWED_CLUSTER_CONTEXT=kind-cascade
CASCADE_ACTIVE_CLUSTER_CONTEXT=kind-cascade
CASCADE_ALLOWED_TARGET_NAMESPACE=cascade-targets
CASCADE_REQUIRE_APPROVAL=true
CASCADE_REQUIRE_DRY_RUN_FIRST=true

VITE_API_BASE_URL=/api
VITE_REFRESH_INTERVAL_MS=10000
VITE_ENABLE_DANGEROUS_ACTIONS=false
PROXY_TIMEOUT_SECONDS=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=60
CASCADE_AUTH_ENABLED=false
CASCADE_LOCAL_DEMO_AUTH_BYPASS=false
CASCADE_API_KEYS=
CASCADE_API_KEY_HASHES=
CASCADE_AUTH_HEADER=Authorization
CASCADE_APPROVAL_SIGNING_SECRET=
FEATURE_EXTRACTOR_SERVICE_URL=http://feature-extractor-service.cascade-system.svc.cluster.local:8013
PROJECT_QA_SERVICE_URL=http://project-qa-service.cascade-system.svc.cluster.local:8040
CASCADE_QA_API_URL=http://localhost:8040
CASCADE_QA_API_KEY=

OPENAI_API_KEY=replace-with-local-key-if-needed
